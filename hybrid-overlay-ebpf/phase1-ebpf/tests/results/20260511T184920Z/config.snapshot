# Phase 1 remote test configuration for the thesis lab hosts.
# Run from the orchestrator machine:
#   ./tests/run_phase1_tests.sh ./tests/phase1_real_setup.conf

CLIENT_HOST="server2"
SERVER_HOST="server1"
CLIENT_CONTAINER="netperf-client"
SERVER_CONTAINER="netperf-server"
SERVER_CONTAINER_IP="10.0.1.2"
REMOTE_PHASE1_DIR="/root/phase1-ebpf"
SSH_OPTS=""
NETSERVER_PORT=12865
REQUEST_SIZE=64
RESPONSE_SIZE=64
RESULT_ROOT="./tests/results"
